      "startArgs": ["--filter", "@jobbank/web", "dev"],
      "url": "http://localhost:3000/api/v1/health",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 180
    },
    {
      "name": "tests-pass",
      "kind": "process",
      "command": "pnpm.cmd",
      "args": ["run", "test"],
      "verificationMethod": "test-results",
      "expected": "0",
      "timeoutSeconds": 1200
    }
  ]
