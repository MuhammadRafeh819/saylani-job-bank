{
  "projectType": "webapp",
  "setup": [],
  "assertions": [
    {
      "name": "production-build",
      "kind": "process",
      "command": "pnpm.cmd",
      "args": ["run", "build"],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 600
    },
    {
